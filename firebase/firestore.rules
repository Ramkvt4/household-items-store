rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Products — public read, authenticated write (admin login required)
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Inquiries from WhatsApp cart (optional future use)
    match /inquiries/{inquiryId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Admin registry (optional — add admin emails as documents)
    match /admins/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Customer shopping carts — owner read/write only (Module 7)
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Customer orders — create own orders; read own orders (Module 8)
    match /orders/{orderId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.resource.data.orderNumber is string
        && request.resource.data.orderStatus == 'placed'
        && (
          request.resource.data.userId == null
          || (request.auth != null && request.resource.data.userId == request.auth.uid)
        );
      allow update, delete: if false;
    }

    // Customer profiles — saved address (Module 8)
    // Wishlist subcollection — owner read/write only (Module 10)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /wishlist/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Coupons — public read for validation; authenticated write (Module 11)
    match /coupons/{couponCode} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Product reviews — public read; owner create/update/delete (Module 12)
    // Path: reviews/{productId}/items/{reviewId}
    // Document ID must equal the author's auth uid (one review per user).
    match /reviews/{productId}/items/{reviewId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == reviewId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.review is string
        && request.resource.data.review.size() >= 10
        && request.resource.data.review.size() <= 1000
        && request.resource.data.verifiedPurchase is bool
        && request.resource.data.keys().hasAll([
          'userId', 'userName', 'rating', 'review',
          'createdAt', 'updatedAt', 'verifiedPurchase'
        ]);

      allow update: if request.auth != null
        && request.auth.uid == reviewId
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userName == resource.data.userName
        && request.resource.data.verifiedPurchase == resource.data.verifiedPurchase
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.review is string
        && request.resource.data.review.size() >= 10
        && request.resource.data.review.size() <= 1000;

      allow delete: if request.auth != null
        && request.auth.uid == reviewId
        && resource.data.userId == request.auth.uid;
    }
  }
}
