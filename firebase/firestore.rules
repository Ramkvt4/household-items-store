rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Products — public read, authenticated write (admin login required)
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Inquiries from WhatsApp cart (optional future use)
    match /inquiries/{inquiryId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Admin registry (optional — add admin emails as documents)
    match /admins/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Customer shopping carts — owner read/write only (Module 7)
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Customer orders — create own orders; read own orders (Module 8)
    match /orders/{orderId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.resource.data.orderNumber is string
        && request.resource.data.orderStatus == 'placed'
        && (
          request.resource.data.userId == null
          || (request.auth != null && request.resource.data.userId == request.auth.uid)
        );
      allow update, delete: if false;
    }

    // Customer profiles — saved address (Module 8)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
